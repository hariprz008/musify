{
  "name": "Mucify - Mobile Music Player",
  "short_name": "Mucify",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "standalone",
    "window-controls-overlay",
    "minimal-ui"
  ],
  "background_color": "#0a0a0d",
  "theme_color": "#121212",
  "orientation": "portrait",
  "description": "Stream and play your favourite music with rich mobile player experience.",
  "lang": "en-US",
  "categories": [
    "music",
    "entertainment",
    "audio"
  ],
  "icons": [
    {
      "src": "assets/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "assets/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "assets/icons/icon-512-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "assets/icons/apple-touch-icon.png",
      "sizes": "180x180",
      "type": "image/png"
    }
  ],
  "shortcuts": [
    {
      "name": "Search Music",
      "short_name": "Search",
      "description": "Search songs, albums and artists",
      "url": "./index.html?view=search",
      "icons": [
        {
          "src": "assets/icons/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Liked Songs",
      "short_name": "Liked",
      "description": "Open your liked tracks",
      "url": "./index.html?view=liked",
      "icons": [
        {
          "src": "assets/icons/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Your Library",
      "short_name": "Library",
      "description": "View playlists and saved music",
      "url": "./index.html?view=library",
      "icons": [
        {
          "src": "assets/icons/icon-192.png",
          "sizes": "192x192"
        }
      ]
    }
  ]
}